# Copy to .env and fill placeholders. No real credentials in this file.
DATABASE_URL=mysql+pymysql://<user>:<url-encoded-password>@<db-host>:<port>/<database>?charset=utf8mb4
# Optional SELECT-only replica connection. Empty means all operations use DATABASE_URL.
DATABASE_READ_URL=
DATABASE_REPLICA_WAIT_SECONDS=0.5
CORS_ORIGINS=["<frontend-origin>"]
ENVIRONMENT=development
MONGODB_URL=mongodb://<user>:<url-encoded-password>@<mongo-host>:<port>/?authSource=<auth-database>
MONGODB_DATABASE=<database-name>
MONGODB_EVENTS_ENABLED=false
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PAYMENTS_ENABLED=false
REFUNDS_ENABLED=false
CULTURE_API_KEY=
# Optional: verified public upstream endpoints have built-in defaults.
# PORTONE_API_BASE_URL=https://api.portone.io
# CULTURE_API_BASE_URL=https://apis.data.go.kr/B553457/nopenapi/rest/publicperformancedisplays
