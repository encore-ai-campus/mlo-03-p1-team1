local.file_match "fastapi_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/culturepick/fastapi.log",
      "job"      = "fastapi",
      "service"  = "mlops-api",
      "host"     = "fastapi1",
      "env"      = "production",
    },
  ]

  sync_period = "5s"
}

loki.source.file "fastapi_logs" {
  targets    = local.file_match.fastapi_logs.targets
  forward_to = [loki.write.central.receiver]

  // 처음 수집을 시작할 때 기존 로그를 모두 읽지 않고
  // 파일의 끝부터 새로 발생하는 로그를 수집
  tail_from_end = true
}

loki.write "central" {
  endpoint {
    url = "http://192.168.0.158:3101/loki/api/v1/push"
  }
}
